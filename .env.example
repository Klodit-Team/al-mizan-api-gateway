# ─────────────────────────────────────────────────────────────────────────────
# AL-Mizan API Gateway — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5673
RABBITMQ_AUDIT_EXCHANGE=audit.events
RABBITMQ_AUDIT_QUEUE=audit.action.log
RABBITMQ_AUDIT_ROUTING_KEY=audit.action.log

# ─── Microservice URLs ─────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
USERS_SERVICE_URL=http://localhost:3002
TENDERS_SERVICE_URL=http://localhost:8003
SUBMISSIONS_SERVICE_URL=http://localhost:8004
DOCUMENTS_SERVICE_URL=http://localhost:8005
EVALUATIONS_SERVICE_URL=http://localhost:8008
COMMISSIONS_SERVICE_URL=http://localhost:8007
APPEALS_SERVICE_URL=http://localhost:8009
AUDIT_SERVICE_URL=http://localhost:3009
NOTIFICATIONS_SERVICE_URL=http://localhost:8010

# ─── Session ────────────────────────────────────────────────────────────────
AUTH_TOKEN_COOKIE_NAME=access_token
SESSION_COOKIE_NAME=al_mizan_sid
SESSION_TTL_SECONDS=3600
PERMISSIONS_TTL_SECONDS=300

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Cookie Security ───────────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# ─── Request ────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
